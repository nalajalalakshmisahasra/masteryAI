# ============================================================================
# Craft Mastery — environment template (variable NAMES ONLY — no real values)
# Copy to backend/.env (server vars) and frontend/.env (EXPO_PUBLIC_* vars).
# NEVER commit real keys, passwords, or service-account JSON.
# ============================================================================

# --- Gemini AI (backend; enables all /api/ai/* endpoints) --------------------
GEMINI_API_KEY=

# --- Firebase: server-side Admin SDK (choose one of the two) -----------------
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Firebase: client config (backend web prototype / status checks) ---------
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# --- Firebase: client config (Expo mobile app) -------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# --- Firebase: client config (legacy Vite web prototype) ---------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# --- Cloudinary ---------------------------------------------------------------
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# --- Background removal service (legacy lowercase spellings are still read ---
# --- by server.ts / config/services.ts — keep both forms) --------------------
REMOVE_BACKGROUND_API=
REMOVE_BACKGROUND_NAME=
REMOVE_BG_API_KEY=
remove background_API=
remove background_name=

# --- Speech / Translation (mobile speech is on-device via expo-speech; -------
# --- EXPO_PUBLIC_AI_SERVICE_URL is reserved for cloud speech/translation) ----
EXPO_PUBLIC_AI_SERVICE_URL=

# --- Backend server -----------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
STORE_DATA_DIR=
MEDIA_STORAGE_DIR=
DEV_AUTH_ENABLED=false
DEMO_DATA_ENABLED=false
VITE_DEMO_DATA=false

# --- Frontend (Expo mobile app) -----------------------------------------------
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_DEMO_DATA=false
